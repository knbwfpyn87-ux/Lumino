# From Supabase: Project Settings -> API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# LiveKit (calls). The token function reads the key/secret from Supabase secrets, not from here.
VITE_LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# AI features (hidden until launch)
VITE_ENABLE_AI=false
# Mr. Lumino's ElevenLabs voice (needs the tts edge function + ELEVENLABS_* Supabase secrets)
VITE_CLOUD_VOICE=off
